# Copiá este archivo como `.env` y completá el valor.
# `.env` está en .gitignore — no se commitea.

# Google OAuth — client tipo "Desktop app".
# Lo generás en https://console.cloud.google.com/ → Credentials → OAuth client ID.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Google EXIGE el client_secret incluso en clients Desktop app (no es confidencial para
# apps instaladas, pero el token endpoint lo pide). Está en el mismo client que el ID.
# ponytail: para el spike va en .env; en producción movelo a Rust (env de compilación) o a un backend.
VITE_GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# Google OAuth — client tipo "Web application" (para la versión web con GIS).
# Sin client_secret. Authorized JavaScript origins: http://localhost:1420 + dominio de Vercel.
VITE_GOOGLE_CLIENT_ID_WEB=xxxxxxxxxxxx.apps.googleusercontent.com
